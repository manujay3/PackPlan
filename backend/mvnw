#!/bin/sh
set -eu

MAVEN_PROJECTBASEDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -z "${JAVA_HOME:-}" ]; then
  JAVA_PATH=$(command -v java || true)
  if [ -z "$JAVA_PATH" ]; then
    echo "JAVA_HOME is not set and java is not on PATH." >&2
    exit 1
  fi
  JAVA_HOME=$(cd "$(dirname "$JAVA_PATH")/.." && pwd)
fi

if [ ! -x "$JAVA_HOME/bin/java" ]; then
  echo "JAVA_HOME does not point to a JDK: $JAVA_HOME" >&2
  exit 1
fi

exec "$JAVA_HOME/bin/java" ${MAVEN_OPTS:-} ${MAVEN_DEBUG_OPTS:-} \
  "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" \
  -classpath "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
